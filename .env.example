# Empty DATA_DIR uses the supplied synthetic ./data if present, otherwise ./sample_data.
# Relative paths resolve from the project root.
# Use DATA_DIR=sample_data to select the smaller isolated test/demo fixtures.
DATA_DIR=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: leave keys empty to use deterministic en/ru/kk explanations.
# Get a NVIDIA inference API key; an account details URL is not an API key.
NVIDIA_API_KEY=
# Optional alternative credential for another compatible provider (takes precedence).
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1/
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_TIMEOUT_SECONDS=6

# Optional test target; export in the test terminal (scripts/Node do not load .env).
# Both e2e_smoke_test.py and the optional frontend integration tests use this.
# Example isolated server: http://127.0.0.1:18001
CAREER_QUEST_TEST_API_URL=
